{
  "manifest_version": 3,
  "name": "Outreach Queue",
  "version": "1.0.0",
  "description": "Daily client-outreach queue: drafted messages, safe caps, one click to open + copy. Never touches the social sites themselves.",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8777/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Outreach Queue", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
